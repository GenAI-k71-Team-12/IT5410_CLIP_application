# Copy values into your shell; the application does not load .env automatically.
CLIP_MODE=mock
CLIP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Real mode: use the metadata snapshot in the artifact and images under dataset_root.
CLIP_ARTIFACT_DIR=artifacts/coco2017-val-vitb32-v1
CLIP_DATASET_ROOT=data/processed/coco2017
CLIP_DEVICE=cpu
CLIP_METHODS=clip
